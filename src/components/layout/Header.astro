---
// src/components/layout/Header.astro
import { Menu, X, ChevronDown, ArrowRight, PenTool, Info, Mail } from 'lucide-react';
import sections from '../../data/sections.json';
import { getCurrentDate } from '../../utils/date';

const currentDate = getCurrentDate();
const currentPath = Astro.url.pathname;

// Sections for the main bar and the expanded drawer
const mainSections = sections.slice(0, 6);
const moreSections = sections.slice(6);
---

<header class="bg-white border-b-[12px] border-black sticky top-0 z-50 select-none">
  <div class="bg-black text-white border-b-2 border-primary">
    <div class="container-custom flex justify-between items-center py-2 text-[10px] font-black uppercase tracking-[0.2em]">
      <div class="flex items-center gap-4">
        <span class="text-primary group-hover:text-white transition-colors italic">Established for the Struggle</span>
        <span class="text-gray-500 hidden sm:inline">//</span>
        <span class="hidden sm:inline">{currentDate}</span>
      </div>
      
      <div class="flex items-center gap-6">
        <a href="/about" class="hover:text-primary transition-colors flex items-center gap-1">
          <Info className="w-3 h-3" /> About
        </a>
        <a href="/contact" class="hover:text-primary transition-colors flex items-center gap-1">
          <Mail className="w-3 h-3" /> Contact
        </a>
        <a href="/submit" class="bg-primary text-white px-3 py-1 hover:bg-white hover:text-black transition-all flex items-center gap-2 border border-primary">
          <PenTool className="w-3 h-3" /> Submit Article
        </a>
      </div>
    </div>
  </div>

  <div class="container-custom py-6 md:py-8 text-center relative overflow-hidden">

    <div class="absolute inset-0 flex justify-center items-center opacity-[0.03] pointer-events-none">
      <span class="text-[12rem] md:text-[14rem] font-black uppercase tracking-tighter">PT</span>

    </div>

    <a href="/" class="group relative inline-block w-full">
      <div class="flex flex-col items-center">
        <span class="text-[10px] font-black uppercase tracking-[0.6em] text-primary mb-2 block">

          Independent Working Class Journalism
        </span>
<h1 class="flex items-end gap-3 text-2xl md:text-4xl lg:text-5xl font-black uppercase tracking-tight italic transition-all duration-500 group-hover:text-primary">

  <span>THE PEOPLE'S</span>
  <span class="text-primary group-hover:text-black transition-colors">
    TRIBUNE
  </span>
</h1>

        <div class="mt-4 flex items-center gap-3 w-full max-w-xl">

          <div class="h-[2px] flex-1 bg-black"></div>
          <div class="px-4 py-1 border-2 border-black font-black uppercase text-[10px] tracking-widest">
            Dispatch No. 001
          </div>
          <div class="h-[2px] flex-1 bg-black"></div>
        </div>
      </div>
    </a>
  </div>

  <nav class="border-t-4 border-black bg-white">
    <div class="container-custom">
      <div class="flex items-stretch justify-center h-16">
        <ul class="hidden lg:flex items-stretch">
          {mainSections.map((section) => (
            <li class="relative group h-full">
              <a 
                href={`/sections/${section.slug}`} 
                class={`h-full flex items-center px-8 font-black uppercase text-xs tracking-widest border-x-[1px] border-black/10 transition-all hover:bg-black hover:text-white ${currentPath.includes(section.slug) ? 'bg-primary text-white' : ''}`}
              >
                {section.name}
              </a>
            </li>
          ))}
          
          {moreSections.length > 0 && (
            <li class="h-full">
              <button id="drawer-toggle" class="h-full flex items-center px-8 font-black uppercase text-xs tracking-widest border-x-[1px] border-black/10 hover:bg-black hover:text-white group transition-colors">
                More Archives <ChevronDown id="drawer-chevron" className="ml-2 w-4 h-4 transition-transform duration-300" />
              </button>
            </li>
          )}
        </ul>

        <button id="mobile-menu-button" class="lg:hidden w-full h-full flex justify-between items-center px-6 font-black uppercase bg-black text-white">
          <div class="flex items-center gap-3">
            <Menu id="menu-icon" className="w-6 h-6 text-primary" />
            <X id="close-icon" className="w-6 h-6 hidden" />
            <span class="tracking-[0.2em]">Operational Menu</span>
          </div>
          <span class="text-[10px] border border-white/30 px-2 py-1 italic">Menu</span>
        </button>
      </div>
    </div>
  </nav>

  <div id="nav-drawer" class="absolute top-full left-0 w-full bg-black text-white border-t-4 border-primary transform -translate-y-4 opacity-0 pointer-events-none transition-all duration-500 z-[-1] shadow-2xl">
    <div class="container-custom py-16">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {sections.map(s => (
          <a href={`/sections/${s.slug}`} class="group border-l-2 border-primary/30 pl-6 hover:border-primary transition-all py-4">
            <h4 class="text-primary font-black uppercase text-[10px] mb-1 tracking-widest opacity-50">{s.slug}</h4>
            <span class="text-2xl font-black uppercase tracking-tighter group-hover:text-primary inline-block transition-colors">{s.name}</span>
          </a>
        ))}
      </div>
      <div class="mt-12 pt-8 border-t border-white/10 flex justify-between items-center">
        <p class="text-[10px] font-black uppercase tracking-widest text-gray-500 italic">
          Accessing Full Theoretical Database...
        </p>
        <ArrowRight className="text-primary w-6 h-6" />
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden fixed inset-x-0 bottom-0 top-[280px] bg-white border-t-8 border-black z-50 overflow-y-auto">
    <div class="container-custom py-12">
      <div class="grid gap-4">
        {sections.map(s => (
          <a href={`/sections/${s.slug}`} class="text-4xl font-black uppercase tracking-tighter border-b-2 border-black/5 pb-4 hover:text-primary transition-colors">
            {s.name}
          </a>
        ))}
        <div class="mt-8 pt-8 border-t-4 border-black space-y-4">
          <a href="/submit" class="block bg-primary text-white p-6 font-black uppercase text-center text-xl shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]">
            Submit Dispatch
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  #nav-drawer.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  
  const drawerToggle = document.getElementById('drawer-toggle');
  const navDrawer = document.getElementById('nav-drawer');
  const drawerChevron = document.getElementById('drawer-chevron');

  // Drawer Logic
  drawerToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = navDrawer?.classList.toggle('open');
    drawerChevron?.classList.toggle('rotate-180', isOpen);
  });

  // Mobile Menu Logic
  menuButton?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
    document.body.style.overflow = isHidden ? '' : 'hidden';
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!navDrawer?.contains(e.target as Node) && !drawerToggle?.contains(e.target as Node)) {
      navDrawer?.classList.remove('open');
      drawerChevron?.classList.remove('rotate-180');
    }
  });
</script>