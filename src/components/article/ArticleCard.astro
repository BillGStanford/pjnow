---
// short-singularity/src/components/article/ArticleCard.astro
import type { Article, Author } from '../../types';
import { formatDateShort } from '../../utils/date';
import { Clock } from 'lucide-react';

interface Props {
  article: Article;
  author: Author;
  featured?: boolean;
  size?: 'small' | 'medium' | 'large';
}

const { article, author, featured = false, size = 'medium' } = Astro.props;
---

<article class={`group h-full flex flex-col ${featured ? 'border-l-4 border-primary pl-4' : ''}`}>
  <a href={`/articles/${article.slug}`} class="block h-full flex flex-col">
    {article.featuredImage && (
      <div class="overflow-hidden h-48">
        <img 
          src={article.featuredImage.src}
          alt={article.featuredImage.alt}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      </div>
    )}

    <div class="flex-1 flex flex-col p-4 space-y-2">
      <div class="flex items-center gap-2 text-xs text-gray-600 uppercase tracking-wide">
        <span class="text-primary font-semibold">{article.section}</span>
        <span>•</span>
        <span>{formatDateShort(article.publishedAt)}</span>
      </div>

      <h3 class={`font-serif font-bold group-hover:text-primary transition-colors line-clamp-2 ${
        size === 'large' ? 'text-2xl' : 
        size === 'medium' ? 'text-xl' : 
        'text-lg'
      }`}>
        {article.title}
      </h3>

      {article.subtitle && size !== 'small' && (
        <p class="text-gray-700 font-serif line-clamp-1">
          {article.subtitle}
        </p>
      )}

      <p class="text-gray-700 line-clamp-3 flex-grow">
        {article.excerpt}
      </p>

      <div class="flex items-center justify-between pt-2 mt-auto">
        <div class="flex items-center gap-2">
          <img 
            src={author.avatar}
            alt={author.name}
            class="w-8 h-8 rounded-full object-cover"
            loading="lazy"
          />
          <div class="text-sm">
            <div class="font-medium">{author.name}</div>
          </div>
        </div>
        <span class="text-xs text-gray-500 flex items-center gap-1">
          <Clock className="w-3 h-3" />
          {Math.ceil(article.content.length / 1000)} min
        </span>
      </div>
    </div>
  </a>
</article>