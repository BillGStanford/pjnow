---
// short-singularity/src/components/article/ArticleCard.astro
import type { Article, Author } from '../../types';
import { formatDateShort } from '../../utils/date';
import { Clock, ChevronRight, ArrowRight } from 'lucide-react';

interface Props {
  article: Article;
  author: Author;
  featured?: boolean;
  size?: 'small' | 'medium' | 'large';
}

const { article, author, featured = false, size = 'medium' } = Astro.props;
---

<article class={`group h-full flex flex-col bg-white border-4 border-black hover:border-primary transition-all ${featured ? 'shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]' : 'shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]'}`}>
  <a href={`/articles/${article.slug}`} class="block h-full flex flex-col">
    {article.featuredImage && (
      <div class="overflow-hidden h-48 border-b-4 border-black">
        <img 
          src={article.featuredImage.src}
          alt={article.featuredImage.alt}
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
          loading="lazy"
        />
        {featured && (
          <div class="absolute top-3 left-3 bg-primary text-white px-3 py-1 text-xs font-black uppercase tracking-wider border-2 border-black">
            Featured
          </div>
        )}
      </div>
    )}

    <div class="flex-1 flex flex-col p-6 space-y-4">
      <div class="flex items-center gap-2 text-xs font-black uppercase tracking-wider text-gray-600">
        <span class="text-primary">{article.section}</span>
        <span>•</span>
        <span>{formatDateShort(article.publishedAt)}</span>
      </div>

      <h3 class={`font-black uppercase tracking-tighter group-hover:text-primary transition-colors line-clamp-2 leading-tight ${
        size === 'large' ? 'text-3xl' : 
        size === 'medium' ? 'text-2xl' : 
        'text-xl'
      }`}>
        {article.title}
      </h3>

      {article.subtitle && size !== 'small' && (
        <p class="text-gray-700 font-bold line-clamp-1 italic border-l-4 border-primary pl-3">
          {article.subtitle}
        </p>
      )}

      <p class="text-gray-700 font-bold line-clamp-3 flex-grow">
        {article.excerpt}
      </p>

      <div class="flex items-center justify-between pt-4 mt-auto border-t-2 border-gray-200">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-black text-white rounded-full flex items-center justify-center font-black">
            {author.name.charAt(0)}
          </div>
          <div class="text-sm">
            <div class="font-black uppercase">{author.name}</div>
            <div class="text-xs text-gray-600 uppercase tracking-wider">{author.role}</div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <Clock className="w-4 h-4 text-gray-600" />
          <span class="text-xs font-black uppercase tracking-wider text-gray-600">
            {Math.ceil(article.content.length / 1000)} MIN
          </span>
        </div>
      </div>
      
      <div class="flex items-center justify-center mt-4">
        <span class="flex items-center gap-2 text-sm font-black uppercase tracking-wider text-primary group-hover:gap-3 transition-all">
          Read Full Report <ArrowRight className="w-4 h-4" />
        </span>
      </div>
    </div>
  </a>
</article>