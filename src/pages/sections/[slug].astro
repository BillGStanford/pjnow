---
// short-singularity/src/pages/sections/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import MetaTags from '../../components/seo/MetaTags.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import articles from '../../data/articles.json';
import authors from '../../data/authors.json';
import sections from '../../data/sections.json';
import type { Article, Author, Section } from '../../types';

export async function getStaticPaths() {
  const allSections = sections as Section[];
  return allSections.map(section => ({
    params: { slug: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props as { section: Section };
const allArticles = articles as Article[];
const allAuthors = authors as Author[];

const sectionArticles = allArticles
  .filter(a => a.section === section.id && a.status === 'published')
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());

function getAuthor(authorId: string): Author {
  return allAuthors.find(a => a.id === authorId) || allAuthors[0];
}
---

<BaseLayout 
  title={`${section.name} | The People's Tribune`}
  description={section.description}
>
  <Fragment slot="head">
    <MetaTags 
      title={`${section.name} | The People's Tribune`}
      description={section.description}
      type="website"
      url={`/sections/${section.slug}`}
    />
    <StructuredData type="section" section={section} />
  </Fragment>

  <div class="container-custom py-8">
    <!-- Section Header -->
    <header class="mb-12 pb-8 border-b-2 border-primary">
      <h1 class="section-title mb-3">
        {section.name}
      </h1>
      <p class="text-lg text-gray-700 max-w-3xl">
        {section.description}
      </p>
    </header>

    <!-- Featured Article -->
    {sectionArticles.length > 0 && (
      <section class="mb-12">
        <div class="grid lg:grid-cols-2 gap-8">
          <div>
            <a href={`/articles/${sectionArticles[0].slug}`} class="group">
              {sectionArticles[0].featuredImage && (
                <img 
                  src={sectionArticles[0].featuredImage.src}
                  alt={sectionArticles[0].featuredImage.alt}
                  class="w-full aspect-[16/9] object-cover mb-4 group-hover:opacity-90 transition-opacity"
                />
              )}
              <h2 class="text-3xl font-serif font-bold mb-3 group-hover:text-primary transition-colors">
                {sectionArticles[0].title}
              </h2>
              {sectionArticles[0].subtitle && (
                <p class="text-xl text-gray-700 mb-4">
                  {sectionArticles[0].subtitle}
                </p>
              )}
              <p class="text-gray-700 line-clamp-3">
                {sectionArticles[0].excerpt}
              </p>
            </a>
          </div>
          
          <div class="flex flex-col justify-center">
            <h3 class="text-xl font-serif font-bold mb-4">Latest in {section.name}</h3>
            <div class="space-y-4">
              {sectionArticles.slice(1, 4).map(article => (
                <div class="pb-4 border-b border-gray-200 last:border-0">
                  <a href={`/articles/${article.slug}`} class="group">
                    <h4 class="font-serif font-bold mb-1 group-hover:text-primary transition-colors">
                      {article.title}
                    </h4>
                    <p class="text-sm text-gray-600 line-clamp-2">
                      {article.excerpt}
                    </p>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Articles Grid -->
    {sectionArticles.length > 4 && (
      <section>
        <h2 class="section-title mb-6">All Articles</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sectionArticles.slice(4).map(article => (
            <ArticleCard 
              article={article}
              author={getAuthor(article.authorId)}
              size="medium"
            />
          ))}
        </div>
      </section>
    )}

    {sectionArticles.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-600">No articles in this section yet.</p>
      </div>
    )}
  </div>
</BaseLayout>