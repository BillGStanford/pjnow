---
// short-singularity/src/pages/articles/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetaTags from '../../components/seo/MetaTags.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import { ContentRenderer } from '../../utils/contentRenderer';
import { formatDate, formatDateISO, getReadingTime } from '../../utils/date';
import { Clock, Tag, Share2, ChevronLeft, Twitter, Facebook, Link2, Mail } from 'lucide-react';
import articles from '../../data/articles.json';
import authors from '../../data/authors.json';
import sections from '../../data/sections.json';
import type { Article, Author, Section } from '../../types';

export async function getStaticPaths() {
  const allArticles = articles as Article[];
  return allArticles
    .filter(a => a.status === 'published')
    .map(article => ({
      params: { slug: article.slug },
      props: { article },
    }));
}

const { article } = Astro.props as { article: Article };
const allAuthors = authors as Author[];
const allSections = sections as Section[];
const allArticles = articles as Article[];

const author = allAuthors.find(a => a.id === article.authorId);
const section = allSections.find(s => s.id === article.section);
const readingTime = getReadingTime(article.content);

// Get more articles from same section
const relatedArticles = allArticles
  .filter(a => a.section === article.section && a.slug !== article.slug && a.status === 'published')
  .slice(0, 4);
---

<BaseLayout 
  title={article.seo.metaTitle}
  description={article.seo.metaDescription}
>
  <Fragment slot="head">
    <MetaTags 
      title={article.seo.metaTitle}
      description={article.seo.metaDescription}
      image={article.featuredImage.src}
      imageAlt={article.featuredImage.alt}
      type="article"
      url={`/articles/${article.slug}`}
      publishedTime={formatDateISO(article.publishedAt)}
      modifiedTime={article.updatedAt ? formatDateISO(article.updatedAt) : undefined}
      author={author?.name}
      section={section?.name}
      tags={article.tags}
    />
    <StructuredData type="article" article={article} author={author} />
  </Fragment>

  <article class="bg-white">
    <!-- Hero Section with Featured Image -->
    {article.featuredImage && (
      <div class="relative h-96 md:h-[500px] lg:h-[600px] overflow-hidden">
        <img 
          src={article.featuredImage.src}
          alt={article.featuredImage.alt}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent"></div>
        
        <div class="absolute bottom-0 left-0 right-0 container-custom pb-8">
          <div class="max-w-4xl mx-auto">
            <div class="flex items-center gap-2 text-sm text-white uppercase tracking-wide mb-4">
              <a 
                href={`/sections/${section?.slug}`}
                class="text-primary hover:underline font-semibold"
              >
                {section?.name}
              </a>
              <span>•</span>
              <time datetime={formatDateISO(article.publishedAt)}>
                {formatDate(article.publishedAt)}
              </time>
              <span>•</span>
              <span class="flex items-center gap-1">
                <Clock className="w-3 h-3" />
                {readingTime} min read
              </span>
            </div>
            
            <h1 class="text-3xl md:text-5xl lg:text-6xl font-serif font-bold text-white mb-4 leading-tight">
              {article.title}
            </h1>
            
            {article.subtitle && (
              <p class="text-xl md:text-2xl lg:text-3xl text-gray-100 font-serif mb-6 leading-relaxed">
                {article.subtitle}
              </p>
            )}
          </div>
        </div>
      </div>
    )}

    <!-- Article Content -->
    <div class="container-custom py-12">
      <div class="max-w-4xl mx-auto">
        <!-- Author Info with Enhanced Design -->
        {author && (
          <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8 pb-8 border-b border-gray-200">
            <div class="flex items-center gap-4 mb-4 md:mb-0">
              <img 
                src={author.avatar}
                alt={author.name}
                class="w-20 h-20 rounded-full object-cover border-4 border-white shadow-lg"
              />
              <div>
                <div class="font-bold text-xl mb-1">{author.name}</div>
                <div class="text-gray-600 mb-2">{author.role}</div>
                <div class="text-sm text-gray-500">
                  Published on {formatDate(article.publishedAt)}
                  {article.updatedAt && ` • Updated ${formatDate(article.updatedAt)}`}
                </div>
              </div>
            </div>
            
            <!-- Share Button with Dropdown -->
            <div class="relative" id="share-dropdown">
              <button 
                class="flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-md hover:bg-primary-dark transition-colors font-medium"
                onclick="document.getElementById('share-menu').classList.toggle('hidden')"
              >
                <Share2 className="w-4 h-4" />
                Share Article
              </button>
              
              <div id="share-menu" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-md shadow-lg border border-gray-200 z-10">
                <div class="py-2">
                  <button 
                    onclick="window.open('https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=' + encodeURIComponent(window.location.href), '_blank')"
                    class="flex items-center gap-3 w-full px-4 py-2 text-gray-700 hover:bg-gray-100 transition-colors"
                  >
                    <Twitter className="w-4 h-4" />
                    Share on Twitter
                  </button>
                  <button 
                    onclick="window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(window.location.href), '_blank')"
                    class="flex items-center gap-3 w-full px-4 py-2 text-gray-700 hover:bg-gray-100 transition-colors"
                  >
                    <Facebook className="w-4 h-4" />
                    Share on Facebook
                  </button>
                  <button 
                    onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!');"
                    class="flex items-center gap-3 w-full px-4 py-2 text-gray-700 hover:bg-gray-100 transition-colors"
                  >
                    <Link2 className="w-4 h-4" />
                    Copy Link
                  </button>
                  <button 
                    onclick="window.location.href='mailto:?subject=${encodeURIComponent(article.title)}&body=' + encodeURIComponent('Check out this article: ' + window.location.href)"
                    class="flex items-center gap-3 w-full px-4 py-2 text-gray-700 hover:bg-gray-100 transition-colors"
                  >
                    <Mail className="w-4 h-4" />
                    Share via Email
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}

        <!-- Table of Contents for Long Articles -->
        {article.content.length > 5000 && (
          <div class="mb-8 p-6 bg-gray-50 rounded-lg">
            <h3 class="font-serif font-bold text-lg mb-4">Table of Contents</h3>
            <nav id="table-of-contents" class="text-sm">
              <!-- TOC will be populated by JavaScript -->
            </nav>
          </div>
        )}

        <!-- Article Body with Enhanced Typography -->
        <div class="prose prose-lg max-w-none article-content">
          <ContentRenderer content={article.content} client:load />
        </div>

        <!-- Progress Bar -->
        <div class="fixed top-0 left-0 w-full h-1 bg-gray-200 z-50">
          <div id="progress-bar" class="h-full bg-primary transition-all duration-150" style="width: 0%"></div>
        </div>

        <!-- Tags with Better Styling (NON-CLICKABLE) -->
        {article.tags && article.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-12 pt-8 border-t border-gray-200">
            <Tag className="w-4 h-4 text-gray-500 mt-1" />
            {article.tags.map(tag => (
              <span 
                class="px-4 py-2 bg-gray-100 text-sm rounded-full cursor-default"
              >
                #{tag}
              </span>
            ))}
          </div>
        )}

        <!-- Sources with Enhanced Design -->
        {article.sources && article.sources.length > 0 && (
          <section class="mt-12 pt-8 border-t border-gray-200">
            <h3 class="text-2xl font-serif font-bold mb-6 flex items-center gap-2">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
              Sources & Bibliography
            </h3>
            <div class="space-y-4">
              {article.sources.map((source, index) => (
                <div class="p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                  <div class="flex items-start gap-3">
                    <span class="flex-shrink-0 w-6 h-6 bg-primary text-white text-xs rounded-full flex items-center justify-center font-bold">
                      {index + 1}
                    </span>
                    <div class="flex-1">
                      <p class="text-sm text-gray-700">
                        {source.author}. <em>{source.title}</em>. 
                        {source.publisher && ` ${source.publisher},`} {source.year}.
                      </p>
                      {source.url && (
                        <a 
                          href={source.url} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="text-primary hover:underline text-sm mt-1 inline-block"
                        >
                          View Source →
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Back to Top Button -->
        <button 
          id="back-to-top"
          onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
          class="fixed bottom-8 right-8 p-3 bg-primary text-white rounded-full shadow-lg hover:bg-primary-dark transition-all opacity-0 invisible"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Enhanced Related Articles -->
    {relatedArticles.length > 0 && (
      <section class="bg-gray-50 py-16">
        <div class="container-custom">
          <div class="max-w-6xl mx-auto">
            <div class="flex items-center justify-between mb-10">
              <div>
                <h2 class="text-3xl font-serif font-bold mb-2">More from {section?.name}</h2>
                <p class="text-gray-600">Continue reading related analysis</p>
              </div>
              <a href={`/sections/${section?.slug}`} class="text-primary hover:underline flex items-center gap-2 font-medium">
                View all articles
                <ChevronLeft className="w-4 h-4 rotate-180" />
              </a>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
              {relatedArticles.map(related => {
                const relatedAuthor = allAuthors.find(a => a.id === related.authorId);
                return (
                  <article class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                    <a href={`/articles/${related.slug}`} class="group block h-full">
                      {related.featuredImage && (
                        <div class="h-48 overflow-hidden relative">
                          <img 
                            src={related.featuredImage.src}
                            alt={related.featuredImage.alt}
                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                            loading="lazy"
                          />
                          <div class="absolute top-3 left-3">
                            <span class="px-2 py-1 bg-primary/90 text-white text-xs font-semibold rounded">
                              {related.section}
                            </span>
                          </div>
                        </div>
                      )}
                      <div class="p-5">
                        <h3 class="font-serif font-bold text-lg mb-2 group-hover:text-primary transition-colors line-clamp-2">
                          {related.title}
                        </h3>
                        {related.subtitle && (
                          <p class="text-sm text-gray-600 line-clamp-1 mb-3 italic">
                            {related.subtitle}
                          </p>
                        )}
                        <p class="text-sm text-gray-700 line-clamp-2 mb-4">
                          {related.excerpt}
                        </p>
                        <div class="flex items-center justify-between text-xs text-gray-500">
                          <div class="flex items-center gap-2">
                            <img 
                              src={relatedAuthor?.avatar || '/images/default-avatar.jpg'}
                              alt={relatedAuthor?.name || 'Author'}
                              class="w-5 h-5 rounded-full"
                            />
                            <span>{relatedAuthor?.name || 'Anonymous'}</span>
                          </div>
                          <span>{formatDate(related.publishedAt)}</span>
                        </div>
                      </div>
                    </a>
                  </article>
                );
              })}
            </div>
          </div>
        </div>
      </section>
    )}
  </article>

  <script>
  // Progress bar + back to top button
  window.addEventListener('scroll', () => {
    const progressBar = document.getElementById('progress-bar');
    const backToTop = document.getElementById('back-to-top');

    const winScroll =
      document.documentElement.scrollTop || document.body.scrollTop;
    const height =
      document.documentElement.scrollHeight -
      document.documentElement.clientHeight;

    if (progressBar && height > 0) {
      const scrolled = (winScroll / height) * 100;
      progressBar.style.width = scrolled + '%';
    }

    // Back to top visibility (guarded)
    if (backToTop) {
      if (winScroll > 500) {
        backToTop.classList.remove('opacity-0', 'invisible');
        backToTop.classList.add('opacity-100', 'visible');
      } else {
        backToTop.classList.add('opacity-0', 'invisible');
        backToTop.classList.remove('opacity-100', 'visible');
      }
    }
  });

  // Close share menu when clicking outside
document.addEventListener('click', (e) => {
  const shareDropdown = document.getElementById('share-dropdown');
  const shareMenu = document.getElementById('share-menu');

  const target = e.target;
  if (
    shareDropdown &&
    shareMenu &&
    target instanceof Node &&
    !shareDropdown.contains(target)
  ) {
    shareMenu.classList.add('hidden');
  }
});


  // Generate table of contents
  document.addEventListener('DOMContentLoaded', () => {
    const tocContainer = document.getElementById('table-of-contents');
    if (!tocContainer) return;

    const headings = document.querySelectorAll(
      '.article-content h2, .article-content h3'
    );

    if (headings.length === 0) {
      if (tocContainer.parentElement) {
        tocContainer.parentElement.style.display = 'none';
      }
      return;
    }

    headings.forEach((heading, index) => {
      if (!heading.id) {
        heading.id = `heading-${index}`;
      }

      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.className =
        'block py-1 hover:text-primary transition-colors';
      link.textContent = heading.textContent || '';

      if (heading.tagName === 'H3') {
        link.classList.add('ml-4');
      }

      tocContainer.appendChild(link);
    });
  });
</script>

</BaseLayout>