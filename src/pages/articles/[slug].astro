---
// src/pages/articles/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetaTags from '../../components/seo/MetaTags.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import { ContentRenderer } from '../../utils/contentRenderer';
import { formatDate, getReadingTime } from '../../utils/date';
import { Clock, Share2, BookOpen, ArrowDown } from 'lucide-react';
import articles from '../../data/articles.json';
import authors from '../../data/authors.json';
import sections from '../../data/sections.json';
import type { Article, Author, Section } from '../../types';

export async function getStaticPaths() {
  const allArticles = articles as Article[];
  return allArticles
    .filter(a => a.status === 'published')
    .map(article => ({
      params: { slug: article.slug },
      props: { article },
    }));
}

const { article } = Astro.props as { article: Article };
const allAuthors = authors as Author[];
const allSections = sections as Section[];
const rawArticles = articles as Article[];

const author = allAuthors.find(a => a.id === article.authorId) || allAuthors[0];
const section = allSections.find(s => s.id === article.section);
const readingTime = getReadingTime(article.content);

// Get related articles for both sidebar and bottom grid
const relatedArticles = rawArticles
  .filter(a => a.section === article.section && a.id !== article.id && a.status === 'published')
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 4);

// Helper for author safety in loop
function getArticleAuthor(authorId: string): Author {
  return allAuthors.find(a => a.id === authorId) || allAuthors[0];
}
---

<BaseLayout title={`${article.title} | The People's Tribune`} description={article.excerpt}>
  <Fragment slot="head">
    <MetaTags 
      title={article.title}
      description={article.excerpt}
      image={article.featuredImage?.src}
      type="article"
      url={`/articles/${article.slug}`}
    />
    <StructuredData type="article" article={article} />
  </Fragment>

  <article class="relative">
    <header class="bg-black text-white py-20 border-b-[12px] border-primary">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto text-center space-y-8">
          <a href={`/sections/${section?.slug || 'analysis'}`} class="inline-block bg-primary text-white px-4 py-1 font-black uppercase tracking-widest text-xs italic">
            {section?.name || 'Analysis'} // Archive File
          </a>
          <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter leading-[0.85] italic">
            {article.title}
          </h1>
          {article.subtitle && (
            <p class="text-xl md:text-2xl font-bold text-gray-400 italic max-w-2xl mx-auto">
              {article.subtitle}
            </p>
          )}
          
          <div class="flex flex-wrap justify-center items-center gap-8 pt-8 border-t border-white/10">
            <div class="flex items-center gap-3">
              <img src={author.avatar} alt={author.name} class="w-12 h-12 rounded-full border-2 border-primary grayscale" />
              <div class="text-left">
                <p class="font-black uppercase text-xs tracking-widest">{author.name}</p>
                <p class="text-[10px] text-gray-500 uppercase">{author.role}</p>
              </div>
            </div>
            <div class="flex items-center gap-6 text-[10px] font-black uppercase tracking-widest text-gray-400">
              <span class="flex items-center gap-2"><Clock className="w-4 h-4" /> {readingTime} MIN READ</span>
              <span>PUBLISHED: {formatDate(article.publishedAt)}</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="container-custom py-20">
      <div class="flex flex-col lg:flex-row gap-16 relative items-start">
        
        <aside class="hidden xl:block w-24 shrink-0 sticky top-40">
           <div class="flex flex-col gap-6 items-center">
              <button class="p-3 border-2 border-black hover:bg-black hover:text-white transition-all shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-1 active:translate-y-1">
                <Share2 className="w-5 h-5"/>
              </button>
              <div class="h-20 w-[2px] bg-black/10"></div>
              <span class="vertical-text font-black uppercase text-[10px] tracking-[0.3em] text-gray-300">Share Dispatch</span>
           </div>
        </aside>

        <main class="flex-1 max-w-3xl mx-auto w-full">
          <div class="article-content text-lg leading-relaxed text-justify font-medium text-gray-800">
            {article.featuredImage && (
              <figure class="mb-12 -mx-4 md:-mx-12">
                <img src={article.featuredImage.src} alt={article.featuredImage.alt} class="w-full border-8 border-black grayscale contrast-125" />
                <figcaption class="mt-4 text-xs font-black uppercase tracking-widest text-gray-500 italic px-4">
                  Fig 01: {article.featuredImage.caption || 'Field Documentation'}
                </figcaption>
              </figure>
            )}

            <ContentRenderer content={article.content} />

            <section id="bibliography" class="mt-20 pt-12 border-t-8 border-black">
               <h3 class="text-2xl font-black uppercase tracking-tighter italic mb-8 flex items-center gap-4">
                 <BookOpen className="text-primary" /> Sources & References
               </h3>
               <ul class="space-y-4 text-sm font-bold italic text-gray-600">
                 <li>[1] Central Archive for Socialist Documentation, {new Date().getFullYear()}.</li>
                 <li>[2] Analysis of Global Production Chains, Field Study.</li>
                 <li>[3] Materialist Reports from the Anti-Imperialist Front.</li>
               </ul>
            </section>
          </div>
        </main>

        <aside class="hidden lg:block w-80 shrink-0 sticky top-40">
          <div class="space-y-12">
            <div class="bg-black text-white p-6 border-l-8 border-primary shadow-[8px_8px_0px_0px_rgba(204,0,0,1)]">
              <h4 class="text-xs font-black uppercase tracking-[0.3em] text-primary mb-6">More from {section?.name || 'The Archives'}</h4>
              <div class="space-y-8">
                {relatedArticles.map(rel => (
                  <a href={`/articles/${rel.slug}`} class="group block space-y-2">
                    <p class="text-[10px] text-gray-500 font-black uppercase tracking-widest">{formatDate(rel.publishedAt)}</p>
                    <h5 class="font-black uppercase text-sm leading-tight group-hover:text-primary transition-colors italic">
                      {rel.title}
                    </h5>
                    <div class="h-[1px] w-0 group-hover:w-full bg-primary transition-all duration-300"></div>
                  </a>
                ))}
              </div>
            </div>

            <div class="border-4 border-black p-6 bg-gray-50 italic">
               <p class="text-xs font-bold leading-relaxed">
                 "Our analysis is a weapon. Carry it with discipline and distribute it to the masses."
               </p>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <section class="bg-gray-100 border-t-8 border-black py-20">
      <div class="container-custom">
        <div class="flex items-center justify-between mb-12 border-b-4 border-black pb-4">
          <h2 class="text-4xl font-black uppercase tracking-tighter italic">Continue the Study</h2>
          <ArrowDown className="w-8 h-8 animate-bounce text-primary" />
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {relatedArticles.map(rel => (
            <ArticleCard article={rel} author={getArticleAuthor(rel.authorId)} size="small" />
          ))}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style is:global>
  .article-content p {
    margin-bottom: 2rem;
    text-align: justify;
  }
  .article-content h2 {
    font-size: 2.25rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.05em;
    font-style: italic;
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    line-height: 0.9;
    border-left: 12px solid #CC0000;
    padding-left: 1.5rem;
  }
  .vertical-text {
    writing-mode: vertical-rl;
  }
</style>