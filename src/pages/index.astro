---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/article/ArticleCard.astro';
import MetaTags from '../components/seo/MetaTags.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import articles from '../data/articles.json';
import authors from '../data/authors.json';
import type { Article, Author } from '../types';

const allArticles = articles as Article[];
const allAuthors = authors as Author[];

// Get lead article
const leadArticle = allArticles.find(a => a.lead && a.status === 'published');

// Get featured articles (excluding lead)
const featuredArticles = allArticles
  .filter(a => a.featured && !a.lead && a.status === 'published')
  .slice(0, 3);

// Get recent articles (excluding lead and featured)
const recentArticles = allArticles
  .filter(a => a.status === 'published' && !a.lead && !a.featured)
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 6);

// Get ALL remaining articles not shown in previous sections
const allRemainingArticles = allArticles
  .filter(a => a.status === 'published')
  .filter(article => 
    !leadArticle || article.id !== leadArticle.id
  )
  .filter(article => 
    !featuredArticles.some(fa => fa.id === article.id)
  )
  .filter(article => 
    !recentArticles.some(ra => ra.id === article.id)
  )
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());

function getAuthor(authorId: string): Author {
  return allAuthors.find(a => a.id === authorId) || allAuthors[0];
}

// Helper to get image src safely
const getImgSrc = (article: Article) => {
  if (article.featuredImage?.src) return article.featuredImage.src;
  // @ts-ignore - fallback for different JSON structures
  return article.image || '/placeholder.jpg';
};

// Calculate reading time for an article
const calculateReadingTime = (content: any[]) => {
  if (!content || !Array.isArray(content)) return 3;
  
  let wordCount = 0;
  content.forEach(item => {
    if (item.type === 'paragraph' && item.text) {
      wordCount += item.text.split(' ').length;
    } else if (item.type === 'heading' && item.text) {
      wordCount += item.text.split(' ').length;
    }
  });
  
  return Math.max(1, Math.ceil(wordCount / 200)); // 200 words per minute
};
---

<BaseLayout 
  title="The People's Tribune | Marxist-Leninist Analysis & Anti-Imperialist News"
  description="A Marxist-Leninist newspaper committed to working-class journalism, anti-imperialist analysis, and the struggle for socialism."
>
  <Fragment slot="head">
    <MetaTags 
      title="The People's Tribune | Marxist-Leninist Analysis & Anti-Imperialist News"
      description="A Marxist-Leninist newspaper committed to working-class journalism, anti-imperialist analysis, and the struggle for socialism."
      type="website"
      url="/"
    />
    <StructuredData type="home" />
  </Fragment>

  <section class="border-b-8 border-black mb-12">
    <div class="bg-primary py-4 border-b-4 border-black">
      <div class="container-custom">
        <p class="text-white font-black uppercase tracking-[0.2em] text-center text-sm">
          Workers of the World, Unite! • {new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase()}
        </p>
      </div>
    </div>
    
    {leadArticle && (
      <div class="container-custom py-12">
        <div class="grid lg:grid-cols-12 gap-0 border-4 border-black shadow-[12px_12px_0px_0px_rgba(0,0,0,1)]">
          <div class="lg:col-span-7 bg-white p-8 lg:p-12 border-b-4 lg:border-b-0 lg:border-r-4 border-black">
            <span class="inline-block bg-black text-white px-3 py-1 font-black uppercase text-xs mb-4 tracking-widest">Lead Dispatch</span>
            <a href={`/articles/${leadArticle.slug}`} class="group">
              <h2 class="text-5xl md:text-7xl font-black uppercase leading-none mb-6 group-hover:text-primary transition-colors">
                {leadArticle.title}
              </h2>
              <p class="text-xl font-bold text-gray-700 mb-8 leading-tight">
                {leadArticle.excerpt}
              </p>
            </a>
            <div class="flex items-center justify-between border-t-2 border-black pt-6">
              <div class="font-black uppercase text-sm tracking-tighter text-black">
                By <span class="text-primary">{getAuthor(leadArticle.authorId).name}</span>
              </div>
              <div class="flex items-center gap-4">
                <div class="font-bold text-xs uppercase text-gray-500">
                  {new Date(leadArticle.publishedAt).toLocaleDateString()}
                </div>
                <div class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="font-bold text-xs uppercase text-gray-500">
                    {calculateReadingTime(leadArticle.content)} MIN READ
                  </span>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:col-span-5 bg-gray-200 min-h-[400px] relative overflow-hidden group">
            <img 
              src={getImgSrc(leadArticle)} 
              alt={leadArticle.title}
              class="absolute inset-0 w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 transition-all duration-500"
            />
            <div class="absolute inset-0 bg-primary/20 mix-blend-multiply"></div>
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-6">
              <p class="text-white font-bold text-sm">
                {leadArticle.featuredImage?.caption || ''}
              </p>
            </div>
          </div>
        </div>
      </div>
    )}
  </section>

  <div class="container-custom pb-20">
    <div class="grid lg:grid-cols-3 gap-12 items-start">
      
      <div class="lg:col-span-2 space-y-16">
        <section>
          <div class="flex items-end gap-4 mb-10 border-b-4 border-black pb-2">
            <h2 class="text-4xl font-black uppercase tracking-tighter">Featured Analysis</h2>
            <div class="flex-1 h-2 bg-primary mb-2"></div>
            <span class="text-sm font-black uppercase text-gray-500">
              {featuredArticles.length} ARTICLES
            </span>
          </div>
          <div class="grid md:grid-cols-2 gap-8">
            {featuredArticles.map(article => (
              <div class="h-full">
                <ArticleCard 
                  article={article}
                  author={getAuthor(article.authorId)}
                  featured={true}
                  size="medium"
                />
              </div>
            ))}
          </div>
        </section>

        <section>
          <div class="flex items-end gap-4 mb-10 border-b-4 border-black pb-2">
            <h2 class="text-4xl font-black uppercase tracking-tighter">Recent Dispatches</h2>
            <div class="flex-1 h-2 bg-black mb-2"></div>
            <span class="text-sm font-black uppercase text-gray-500">
              {recentArticles.length} ARTICLES
            </span>
          </div>
          <div class="grid md:grid-cols-2 gap-8">
            {recentArticles.map(article => (
              <div class="h-full">
                <ArticleCard 
                  article={article}
                  author={getAuthor(article.authorId)}
                  featured={false}
                  size="medium"
                />
              </div>
            ))}
          </div>
        </section>

        {allRemainingArticles.length > 0 && (
          <section>
            <div class="flex items-end gap-4 mb-10 border-b-4 border-black pb-2">
              <h2 class="text-4xl font-black uppercase tracking-tighter">Complete Archive</h2>
              <div class="flex-1 h-2 bg-gray-400 mb-2"></div>
              <span class="text-sm font-black uppercase text-gray-500">
                {allRemainingArticles.length} ARTICLES
              </span>
            </div>
            <div class="grid md:grid-cols-2 gap-8">
              {allRemainingArticles.map((article) => (
                <div class="h-full">
                  <ArticleCard 
                    article={article}
                    author={getAuthor(article.authorId)}
                    featured={false}
                    size="medium"
                  />
                </div>
              ))}
            </div>
            
            <div class="mt-8 text-center">
              <a href="/archive" class="inline-block border-4 border-black px-8 py-3 font-black uppercase bg-white hover:bg-primary hover:text-white transition-all shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]">
                View Full Archive
              </a>
            </div>
          </section>
        )}
      </div>

      <aside class="lg:col-span-1 space-y-12">
        <div class="bg-black text-white p-8 transform rotate-1 border-t-8 border-primary shadow-[8px_8px_0px_0px_rgba(204,0,0,1)]">
          <h3 class="text-3xl font-black uppercase mb-4 italic leading-none">Agitate. Educate. Organize.</h3>
          <p class="font-bold mb-6 text-sm leading-snug">Join the struggle for a world free of exploitation. Our press is a weapon in the hands of the workers.</p>
          <a href="/submit" class="block text-center border-2 border-white py-3 font-black uppercase hover:bg-white hover:text-black transition-all">
            Join the Collective
          </a>
        </div>

        <div class="border-4 border-black p-6 bg-white">
          <h3 class="text-xl font-black uppercase mb-6 border-b-2 border-black pb-2">Top Sections</h3>
          <ul class="space-y-4">
            {['World', 'Labor', 'Analysis', 'Imperialism'].map(section => (
              <li>
                <a href={`/sections/${section.toLowerCase().replace(' ', '-')}`} class="flex justify-between items-center group">
                  <span class="font-black uppercase group-hover:text-primary transition-colors">{section}</span>
                  <span class="h-4 w-4 bg-primary group-hover:translate-x-1 transition-transform"></span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="border-4 border-black bg-white">
          <div class="bg-primary text-black p-4">
            <h3 class="font-black uppercase text-lg">Archive Statistics</h3>
          </div>
          <div class="p-6 space-y-4">
            <div class="flex justify-between items-center border-b-2 border-gray-200 pb-2">
              <span class="font-bold uppercase text-sm">Total Articles</span>
              <span class="font-black text-xl text-primary">{allArticles.filter(a => a.status === 'published').length}</span>
            </div>
            <div class="flex justify-between items-center border-b-2 border-gray-200 pb-2">
              <span class="font-bold uppercase text-sm">This Month</span>
              <span class="font-black text-xl text-primary">
                {allArticles.filter(a => {
                  const pubDate = new Date(a.publishedAt);
                  const now = new Date();
                  return a.status === 'published' && 
                         pubDate.getMonth() === now.getMonth() && 
                         pubDate.getFullYear() === now.getFullYear();
                }).length}
              </span>
            </div>
            <div class="flex justify-between items-center">
              <span class="font-bold uppercase text-sm">Contributors</span>
              <span class="font-black text-xl text-primary">{allAuthors.length}</span>
            </div>
          </div>
        </div>

        <div class="border-4 border-black bg-white">
          <div class="bg-black text-white p-4">
            <h3 class="font-black uppercase text-lg">Trending Topics</h3>
          </div>
          <div class="p-6">
            <div class="flex flex-wrap gap-2">
              {['Imperialism', 'Class Struggle', 'Labor Rights', 'Anti-War', 'Socialism', 'Revolution'].map(tag => (
                <a href={`/tags/${tag.toLowerCase().replace(' ', '-')}`} class="px-3 py-1 bg-gray-100 border-2 border-black font-black uppercase text-xs hover:bg-primary hover:text-white transition-all">
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="sticky top-40">
           <div class="bg-primary text-white p-6 border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]">
              <h3 class="font-black uppercase text-xl mb-2">Support the Press</h3>
              <p class="text-xs font-bold uppercase mb-4">We accept no corporate funding. We are powered by the people.</p>
              <button class="w-full bg-black text-white py-3 font-black uppercase text-sm hover:bg-white hover:text-black transition-colors border-2 border-black">
                Donate to the Cause
              </button>
           </div>
           <div class="mt-8 p-4 border-2 border-dashed border-black text-[10px] font-black uppercase italic text-gray-400">
             End of column // Broadcast remains active 24/7
           </div>
        </div>
      </aside>

    </div>
  </div>
</BaseLayout>

<style>
  /* Ensure the marquee in the header (if present) doesn't break layout */
  .container-custom {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>