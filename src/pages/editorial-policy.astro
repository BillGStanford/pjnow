---
// src/pages/editorial-policy.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaTags from '../components/seo/MetaTags.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { Shield, Scale, FileText, AlertCircle } from 'lucide-react';
---

<BaseLayout 
  title="Editorial Policy | The People's Tribune"
  description="Our commitment to revolutionary journalism, Marxist-Leninist analysis, and the highest standards of working-class reporting."
>
  <Fragment slot="head">
    <MetaTags 
      title="Editorial Policy | The People's Tribune"
      description="Our commitment to revolutionary journalism, Marxist-Leninist analysis, and the highest standards of working-class reporting."
      type="website"
      url="/editorial-policy"
    />
    <StructuredData type="section" />
  </Fragment>

  <div class="bg-black text-white py-20 border-b-8 border-primary relative overflow-hidden">
    <div class="absolute top-0 right-0 opacity-10 transform translate-x-1/4 -translate-y-1/4">
        <Shield className="w-96 h-96" />
    </div>
    <div class="container-custom relative z-10">
      <h1 class="text-6xl md:text-8xl font-black uppercase tracking-tighter leading-none mb-6">
        Our <span class="text-primary">Steel</span> & Truth
      </h1>
      <p class="text-2xl font-bold uppercase tracking-widest border-l-8 border-primary pl-6 max-w-3xl">
        Journalism is a weapon. We ensure it is sharpened correctly for the working class.
      </p>
    </div>
  </div>

  <div class="container-custom py-16">
    <div class="max-w-5xl mx-auto">
      
      <section class="mb-20">
        <div class="bg-gray-100 p-8 border-l-8 border-black">
          <p class="text-2xl font-serif italic leading-relaxed text-gray-800">
            "The People's Tribune stands as a voice for the working class, dedicated to exposing the contradictions of capitalism and advancing the cause of revolutionary socialism." [cite: 7]
          </p>
        </div>
      </section>

      <div class="space-y-24">
        
        <div class="grid md:grid-cols-12 gap-8 items-start">
          <div class="md:col-span-4">
            <h2 class="text-4xl font-black uppercase leading-none sticky top-8">
              <span class="text-primary block text-6xl mb-2">01</span>
              Scientific Analysis
            </h2>
          </div>
          <div class="md:col-span-8 border-t-4 border-black pt-6">
            <div class="prose prose-lg max-w-none">
              <p class="font-bold text-xl mb-4 uppercase">Marxist-Leninist Methodology</p>
              <p>We provide uncompromising analysis of current events through a Marxist-Leninist lens. [cite: 8] This means our journalism is not "neutral" in the bourgeois sense, but scientifically committed to the material conditions and liberation of the oppressed. [cite: 8, 14]</p>
            </div>
          </div>
        </div>

        <div class="grid md:grid-cols-12 gap-8 items-start">
          <div class="md:col-span-4">
            <h2 class="text-4xl font-black uppercase leading-none sticky top-8">
              <span class="text-primary block text-6xl mb-2">02</span>
              Class Independence
            </h2>
          </div>
          <div class="md:col-span-8 border-t-4 border-black pt-6">
            <div class="prose prose-lg max-w-none">
              <p class="font-bold text-xl mb-4 uppercase">Free from Bourgeois Propaganda</p>
              <p>In an era of corporate media consolidation, we serve as an independent platform. [cite: 9] We prioritize the voices and experiences of those most affected by capitalist exploitation. [cite: 11, 12]</p>
            </div>
          </div>
        </div>

        <div class="grid md:grid-cols-12 gap-8 items-start">
          <div class="md:col-span-4">
            <h2 class="text-4xl font-black uppercase leading-none sticky top-8">
              <span class="text-primary block text-6xl mb-2">03</span>
              Global Solidarity
            </h2>
          </div>
          <div class="md:col-span-8 border-t-4 border-black pt-6">
            <div class="prose prose-lg max-w-none">
              <p class="font-bold text-xl mb-4 uppercase">Anti-Imperialist Framework</p>
              <p>Our reporting connects local struggles to global movements for liberation. [cite: 8] We stand in solidarity with oppressed peoples worldwide and support anti-imperialist struggles across the globe. [cite: 16]</p>
            </div>
          </div>
        </div>

        <div class="grid md:grid-cols-12 gap-8 items-start">
          <div class="md:col-span-4">
            <h2 class="text-4xl font-black uppercase leading-none sticky top-8">
              <span class="text-primary block text-6xl mb-2">04</span>
              Collective Responsibility
            </h2>
          </div>
          <div class="md:col-span-8 border-t-4 border-black pt-6">
            <div class="prose prose-lg max-w-none">
              <p class="font-bold text-xl mb-4 uppercase">The Editorial Board</p>
              <p>Our operations are supported by dedicated volunteers who believe in independent socialist media. [cite: 31, 32] The editorial board consists of experienced activists, journalists, and scholars committed to revolutionary principles. [cite: 27, 28]</p>
            </div>
          </div>
        </div>

      </div>

      <div class="mt-32 bg-primary p-1 text-black transform -rotate-1">
        <div class="bg-white p-12 border-4 border-black">
          <h2 class="text-5xl font-black uppercase mb-6 tracking-tighter italic">Found an Error?</h2>
          <p class="text-xl mb-8 font-bold">Scientific analysis requires constant correction and rigor. If you believe a report lacks material accuracy, contact the collective immediately.</p>
          <a href="/contact" class="inline-block bg-black text-white px-10 py-4 font-black uppercase text-xl hover:bg-primary transition-all">
            Report Correction
          </a>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>