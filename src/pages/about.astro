---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaTags from '../components/seo/MetaTags.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { Users, Target, BookOpen, Globe, ArrowRight } from 'lucide-react';
---

<BaseLayout 
  title="About Us | The People's Tribune"
  description="Learn about The People's Tribune - A Marxist-Leninist newspaper committed to working-class journalism, anti-imperialist analysis, and the struggle for socialism."
>
  <Fragment slot="head">
    <MetaTags 
      title="About Us | The People's Tribune"
      description="Learn about The People's Tribune - A Marxist-Leninist newspaper committed to working-class journalism, anti-imperialist analysis, and the struggle for socialism."
      type="website"
      url="/about"
    />
    <StructuredData type="section" />
  </Fragment>

  <div class="bg-black text-white py-20 border-b-8 border-primary">
    <div class="container-custom">
      <div class="max-w-5xl">
        <h1 class="text-6xl md:text-8xl font-black uppercase tracking-tighter leading-none mb-8 italic">
          Voice of the <span class="text-primary">Proletariat</span>
        </h1>
        <p class="text-2xl md:text-3xl font-bold max-w-3xl leading-tight border-l-8 border-primary pl-6">
          The People's Tribune is a Marxist-Leninist newspaper committed to working-class journalism and the global struggle for socialism[cite: 5].
        </p>
      </div>
    </div>
  </div>

  <div class="container-custom py-16">
    <section class="grid lg:grid-cols-12 gap-12 mb-24 items-start">
      <div class="lg:col-span-5 bg-primary text-white p-10 transform -rotate-1 shadow-2xl">
        <h2 class="text-4xl font-black uppercase mb-6 flex items-center gap-3">
          <Target className="w-10 h-10" />
          Our Mission
        </h2>
        <div class="prose prose-invert prose-lg">
          <p class="font-bold text-xl leading-snug mb-6">
            We stand as a voice for the working class, dedicated to exposing the contradictions of capitalism[cite: 8].
          </p>
          <p>
            In an era of corporate media consolidation and bourgeois propaganda, we serve as an independent platform to challenge imperialist narratives[cite: 10].
          </p>
        </div>
      </div>
      
      <div class="lg:col-span-7 pt-8">
        <h2 class="text-5xl font-black uppercase mb-12 tracking-tight">Core Principles</h2>
        <div class="grid sm:grid-cols-2 gap-x-8 gap-y-12">
          <div class="border-t-4 border-black pt-4">
            <h3 class="font-black text-2xl uppercase mb-2 flex items-center gap-2">
              <Users className="text-primary w-6 h-6" /> Worker-Led
            </h3>
            <p class="text-gray-700">Created by and for the working class, prioritizing experiences of capitalist exploitation[cite: 12, 13].</p>
          </div>
          
          <div class="border-t-4 border-black pt-4">
            <h3 class="font-black text-2xl uppercase mb-2 flex items-center gap-2">
              <BookOpen className="text-primary w-6 h-6" /> Scientific Analysis
            </h3>
            <p class="text-gray-700">Applying Marxist-Leninist methodology to understand the material conditions shaping our world[cite: 14, 15].</p>
          </div>
          
          <div class="border-t-4 border-black pt-4">
            <h3 class="font-black text-2xl uppercase mb-2 flex items-center gap-2">
              <Globe className="text-primary w-6 h-6" /> Internationalism
            </h3>
            <p class="text-gray-700">Standing in solidarity with oppressed peoples and anti-imperialist struggles worldwide[cite: 16, 17].</p>
          </div>
          
          <div class="border-t-4 border-black pt-4">
            <h3 class="font-black text-2xl uppercase mb-2 flex items-center gap-2">
              <Target className="text-primary w-6 h-6" /> Revolutionary
            </h3>
            <p class="text-gray-700">We work to change the world, supporting concrete actions for socialist transformation[cite: 18, 19].</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-24 bg-gray-100 p-12 border-4 border-dashed border-gray-400">
      <h2 class="text-5xl font-black uppercase mb-10 text-center tracking-tighter">The Struggle So Far</h2>
      <div class="space-y-12 max-w-4xl mx-auto">
        <div class="flex gap-6 items-start">
          <span class="text-6xl font-black text-primary opacity-30">2020</span>
          <div>
            <h3 class="text-2xl font-black uppercase mb-2">Founded in Resistance</h3>
            <p class="text-gray-700 text-lg">Emerging from the need for independent socialist media to challenge mainstream narratives[cite: 20, 22].</p>
          </div>
        </div>
        
        <div class="flex gap-6 items-start">
          <span class="text-6xl font-black text-primary opacity-30">TODAY</span>
          <div>
            <h3 class="text-2xl font-black uppercase mb-2">A Growing Movement</h3>
            <p class="text-gray-700 text-lg">Reaching thousands worldwide and contributing to vital political discussions[cite: 24].</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-24">
      <h2 class="text-5xl font-black uppercase mb-12 text-center underline decoration-primary decoration-8 underline-offset-8">The Collective</h2>
      <div class="grid md:grid-cols-3 gap-0 border-4 border-black">
        <div class="p-8 border-b-4 md:border-b-0 md:border-r-4 border-black hover:bg-primary hover:text-white transition-colors group">
          <h3 class="font-black text-2xl uppercase mb-4">Editorial Board</h3>
          <p class="group-hover:text-white text-gray-700">Experienced activists and scholars committed to Marxist-Leninist principles[cite: 28].</p>
        </div>
        
        <div class="p-8 border-b-4 md:border-b-0 md:border-r-4 border-black hover:bg-primary hover:text-white transition-colors group">
          <h3 class="font-black text-2xl uppercase mb-4">Contributing Writers</h3>
          <p class="group-hover:text-white text-gray-700">Workers, organizers, and intellectuals from around the world[cite: 29, 30].</p>
        </div>
        
        <div class="p-8 hover:bg-primary hover:text-white transition-colors group">
          <h3 class="font-black text-2xl uppercase mb-4">Volunteer Staff</h3>
          <p class="group-hover:text-white text-gray-700">Dedicated volunteers supporting independent socialist media[cite: 31, 32].</p>
        </div>
      </div>
    </section>

    <section class="bg-black text-white p-12 text-center transform rotate-1">
      <h2 class="text-5xl font-black uppercase mb-6 tracking-tighter">Join the Movement</h2>
      <p class="text-xl mb-10 max-w-2xl mx-auto font-bold uppercase">
        The People's Tribune is a tool for building the revolutionary movement[cite: 33].
      </p>
      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <a href="/submit" class="bg-primary text-white px-10 py-4 font-black uppercase text-xl hover:bg-white hover:text-black transition-all">
          Submit Article
        </a>
        <a href="/subscribe" class="border-4 border-white text-white px-10 py-4 font-black uppercase text-xl hover:bg-white hover:text-black transition-all">
          Subscribe
        </a>
      </div>
    </section>
  </div>
</BaseLayout>