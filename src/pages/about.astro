---
// short-singularity/src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaTags from '../components/seo/MetaTags.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { Users, Target, BookOpen, Globe } from 'lucide-react';
---

<BaseLayout 
  title="About Us | The People's Tribune"
  description="Learn about The People's Tribune - A Marxist-Leninist newspaper committed to working-class journalism, anti-imperialist analysis, and the struggle for socialism."
>
  <Fragment slot="head">
    <MetaTags 
      title="About Us | The People's Tribune"
      description="Learn about The People's Tribune - A Marxist-Leninist newspaper committed to working-class journalism, anti-imperialist analysis, and the struggle for socialism."
      type="website"
      url="/about"
    />
    <StructuredData type="section" />

  </Fragment>

  <div class="container-custom py-12">
    <!-- Hero Section -->
    <section class="mb-16">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-primary mb-6">
          About The People's Tribune
        </h1>
        <p class="text-xl text-gray-700 leading-relaxed">
          A Marxist-Leninist newspaper committed to working-class journalism, 
          anti-imperialist analysis, and the struggle for socialism.
        </p>
      </div>
    </section>

    <!-- Mission Statement -->
    <section class="mb-16">
      <div class="max-w-4xl mx-auto">
        <div class="bg-gray-50 p-8 rounded-lg">
          <h2 class="text-3xl font-serif font-bold mb-6 flex items-center gap-3">
            <Target className="w-8 h-8 text-primary" />
            Our Mission
          </h2>
          <div class="prose prose-lg max-w-none">
            <p class="text-gray-700 leading-relaxed mb-4">
              The People's Tribune stands as a voice for the working class, dedicated to exposing 
              the contradictions of capitalism and advancing the cause of revolutionary socialism. 
              We provide uncompromising analysis of current events through a Marxist-Leninist lens, 
              connecting local struggles to global movements for liberation.
            </p>
            <p class="text-gray-700 leading-relaxed">
              In an era of corporate media consolidation and bourgeois propaganda, we serve as an 
              independent platform for workers, students, and activists to access honest journalism 
              that challenges imperialist narratives and supports movements for social change.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Values -->
    <section class="mb-16">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-serif font-bold mb-10 text-center">Our Core Values</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center mx-auto mb-4">
              <Users className="w-8 h-8" />
            </div>
            <h3 class="font-serif font-bold text-xl mb-3">Worker-Led</h3>
            <p class="text-gray-700">
              Our content is created by and for the working class, prioritizing the voices 
              and experiences of those most affected by capitalist exploitation.
            </p>
          </div>
          
          <div class="text-center">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center mx-auto mb-4">
              <BookOpen className="w-8 h-8" />
            </div>
            <h3 class="font-serif font-bold text-xl mb-3">Scientific Analysis</h3>
            <p class="text-gray-700">
              We apply Marxist-Leninist methodology to analyze current events, providing 
              readers with tools to understand the material conditions shaping our world.
            </p>
          </div>
          
          <div class="text-center">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center mx-auto mb-4">
              <Globe className="w-8 h-8" />
            </div>
            <h3 class="font-serif font-bold text-xl mb-3">Internationalism</h3>
            <p class="text-gray-700">
              We stand in solidarity with oppressed peoples worldwide and support anti-imperialist 
              struggles across the globe.
            </p>
          </div>
          
          <div class="text-center">
            <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center mx-auto mb-4">
              <Target className="w-8 h-8" />
            </div>
            <h3 class="font-serif font-bold text-xl mb-3">Revolutionary</h3>
            <p class="text-gray-700">
              We don't just analyze the world – we work to change it, supporting concrete 
              actions and movements for socialist transformation.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- History -->
    <section class="mb-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-serif font-bold mb-8">Our History</h2>
        <div class="space-y-6">
          <div class="border-l-4 border-primary pl-6">
            <h3 class="font-serif font-bold text-xl mb-2">Founded in 2020</h3>
            <p class="text-gray-700">
              The People's Tribune emerged from the growing need for independent socialist media 
              in the digital age. Our founders, a collective of workers, students, and activists, 
              recognized the importance of creating a platform that could challenge mainstream narratives.
            </p>
          </div>
          
          <div class="border-l-4 border-primary pl-6">
            <h3 class="font-serif font-bold text-xl mb-2">Growing Movement</h3>
            <p class="text-gray-700">
              From humble beginnings as a small blog, we've grown into a respected voice in the 
              socialist press, reaching thousands of readers worldwide and contributing to important 
              political discussions.
            </p>
          </div>
          
          <div class="border-l-4 border-primary pl-6">
            <h3 class="font-serif font-bold text-xl mb-2">Looking Forward</h3>
            <p class="text-gray-700">
              As capitalism's crises deepen, our mission becomes more urgent. We continue to expand 
              our reach, develop new forms of media, and strengthen our connections with movements 
              for social change.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="mb-16">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-serif font-bold mb-10 text-center">Our Editorial Collective</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-24 h-24 bg-gray-300 rounded-full mx-auto mb-4"></div>
            <h3 class="font-serif font-bold text-lg mb-2">Editorial Board</h3>
            <p class="text-gray-600 text-sm">
              Our editorial board consists of experienced activists, journalists, and scholars 
              committed to Marxist-Leninist principles.
            </p>
          </div>
          
          <div class="text-center">
            <div class="w-24 h-24 bg-gray-300 rounded-full mx-auto mb-4"></div>
            <h3 class="font-serif font-bold text-lg mb-2">Contributing Writers</h3>
            <p class="text-gray-600 text-sm">
              We feature contributions from workers, organizers, and intellectuals from around 
              the world who share our commitment to revolutionary change.
            </p>
          </div>
          
          <div class="text-center">
            <div class="w-24 h-24 bg-gray-300 rounded-full mx-auto mb-4"></div>
            <h3 class="font-serif font-bold text-lg mb-2">Volunteer Staff</h3>
            <p class="text-gray-600 text-sm">
              Our operations are supported by dedicated volunteers who believe in the importance 
              of independent socialist media.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="bg-primary text-white p-8 rounded-lg text-center">
      <h2 class="text-3xl font-serif font-bold mb-4">Join Our Movement</h2>
      <p class="text-lg mb-6 max-w-2xl mx-auto">
        The People's Tribune is more than a newspaper – it's a tool for building the revolutionary 
        movement. Whether you're a writer, organizer, or concerned citizen, there's a place for you 
        in our collective.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/submit" class="bg-white text-primary px-6 py-3 rounded-md font-bold hover:bg-gray-100 transition-colors">
          Submit an Article
        </a>
        <a href="/subscribe" class="border-2 border-white text-white px-6 py-3 rounded-md font-bold hover:bg-white hover:text-primary transition-colors">
          Subscribe
        </a>
      </div>
    </section>
  </div>
</BaseLayout>