---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaTags from '../components/seo/MetaTags.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { Mail, MessageSquare, Send, MapPin } from 'lucide-react';
---

<BaseLayout 
  title="Contact Us | The People's Tribune"
  description="Get in touch with The People's Tribune. Send us your inquiries, feedback, or join our editorial collective."
>
  <Fragment slot="head">
    <MetaTags 
      title="Contact Us | The People's Tribune"
      description="Get in touch with The People's Tribune. Send us your inquiries, feedback, or join our editorial collective."
      type="website"
      url="/contact"
    />
    <StructuredData type="section" />
  </Fragment>

  <div class="bg-primary text-white py-16 border-b-8 border-black">
    <div class="container-custom">
      <h1 class="text-6xl md:text-8xl font-black uppercase tracking-tighter leading-none mb-4 transform -rotate-1">
        Reach the <span class="bg-black px-4">Collective</span>
      </h1>
      <p class="text-2xl font-bold uppercase tracking-wide max-w-2xl">
        Break the silence. Send us your reports, feedback, and inquiries.
      </p>
    </div>
  </div>

  <div class="container-custom py-16">
    <div class="grid lg:grid-cols-12 gap-0 border-4 border-black">
      
      <div class="lg:col-span-5 bg-gray-100 p-10 border-b-4 lg:border-b-0 lg:border-r-4 border-black">
        <h2 class="text-4xl font-black uppercase mb-8 underline decoration-primary decoration-4 underline-offset-4">
          General Inquiries
        </h2>
        
        <div class="space-y-10">
          <div class="flex items-start gap-4 group">
            <div class="bg-black text-white p-3 group-hover:bg-primary transition-colors">
              <Mail className="w-6 h-6" />
            </div>
            <div>
              <h3 class="font-black uppercase text-xl">Email Us</h3>
              <p class="text-gray-700 text-lg">contact@peoplestribune.org</p>
            </div>
          </div>

          <div class="flex items-start gap-4 group">
            <div class="bg-black text-white p-3 group-hover:bg-primary transition-colors">
              <MessageSquare className="w-6 h-6" />
            </div>
            <div>
              <h3 class="font-black uppercase text-xl">Press & Media</h3>
              <p class="text-gray-700 text-lg">press@peoplestribune.org</p>
            </div>
          </div>

          <div class="flex items-start gap-4 group">
            <div class="bg-black text-white p-3 group-hover:bg-primary transition-colors">
              <MapPin className="w-6 h-6" />
            </div>
            <div>
              <h3 class="font-black uppercase text-xl">Headquarters</h3>
              <p class="text-gray-700 text-lg italic">Organizing everywhere capitalism exploits.</p>
            </div>
          </div>
        </div>

        <div class="mt-16 bg-black text-white p-6 transform rotate-1">
          <h4 class="font-black uppercase text-xl mb-2">Join the Struggle</h4>
          <p class="text-sm">We are always looking for dedicated writers, organizers, and translators to join our volunteer staff.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>