---
// short-singularity/src/pages/submit.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaTags from '../components/seo/MetaTags.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { FileText, Mail, AlertCircle, CheckCircle, Image, Tag, BookOpen, Send } from 'lucide-react';
import sections from '../data/sections.json';
---

<BaseLayout 
  title="Submit an Article | The People's Tribune"
  description="Submit your article to The People's Tribune - Share your Marxist-Leninist analysis and contribute to the working class movement."
>
  <Fragment slot="head">
    <MetaTags 
      title="Submit an Article | The People's Tribune"
      description="Submit your article to The People's Tribune - Share your Marxist-Leninist analysis and contribute to the working class movement."
      type="website"
      url="/submit"
    />
    <StructuredData type="home" />
  </Fragment>

  <div class="container-custom py-12">
    <!-- Hero Section -->
    <section class="mb-16">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-primary mb-6">
          Submit an Article
        </h1>
        <p class="text-xl text-gray-700 leading-relaxed">
          Share your analysis, report on workers' struggles, and contribute to building 
          the revolutionary movement through independent socialist media.
        </p>
      </div>
    </section>

    <!-- Main Submission Information -->
    <section class="mb-16">
      <div class="max-w-2xl mx-auto text-center">
        <div class="bg-primary text-white p-12 rounded-lg">
          <Send className="w-16 h-16 mx-auto mb-6" />
          <h2 class="text-3xl font-serif font-bold mb-4">Submit Your Article</h2>
          <p class="text-lg mb-8">
            Email your submission to:
          </p>
          <a 
            href="mailto:nilecomun@gmail.com" 
            class="text-3xl font-bold text-white hover:text-gray-200 transition-colors underline break-all"
          >
            nilecomun@gmail.com
          </a>
        </div>
      </div>
    </section>

    <!-- Submission Requirements -->
    <section class="mb-16">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-serif font-bold mb-10 text-center">Article Requirements</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Content Requirements -->
          <div class="bg-white border border-gray-200 p-6 rounded-lg">
            <h3 class="font-serif font-bold text-lg mb-4 flex items-center gap-2">
              <FileText className="w-5 h-5 text-primary" />
              Content
            </h3>
            <ul class="space-y-2 text-gray-700 text-sm">
              <li>• 800-2,000 words</li>
              <li>• Original work</li>
              <li>• Clear writing</li>
              <li>• Marxist-Leninist analysis</li>
              <li>• Proper sourcing</li>
            </ul>
          </div>
          
          <!-- Section Selection -->
          <div class="bg-white border border-gray-200 p-6 rounded-lg">
            <h3 class="font-serif font-bold text-lg mb-4 flex items-center gap-2">
              <BookOpen className="w-5 h-5 text-primary" />
              Section
            </h3>
            <p class="text-gray-700 text-sm mb-3">
              Specify your section:
            </p>
            <ul class="space-y-1 text-gray-700 text-sm">
              {sections.map(section => (
                <li>• {section.name}</li>
              ))}
            </ul>
          </div>
          
          <!-- Images -->
          <div class="bg-white border border-gray-200 p-6 rounded-lg">
            <h3 class="font-serif font-bold text-lg mb-4 flex items-center gap-2">
              <Image className="w-5 h-5 text-primary" />
              Images
            </h3>
            <ul class="space-y-2 text-gray-700 text-sm">
              <li>• Include 1 relevant image</li>
              <li>• High resolution</li>
              <li>• Min. 1200px wide</li>
              <li>• Include source/caption</li>
              <li>• Proper attribution</li>
            </ul>
          </div>
          
          <!-- Tags -->
          <div class="bg-white border border-gray-200 p-6 rounded-lg">
            <h3 class="font-serif font-bold text-lg mb-4 flex items-center gap-2">
              <Tag className="w-5 h-5 text-primary" />
              Tags
            </h3>
            <p class="text-gray-700 text-sm mb-3">
              Suggest 3-5 tags:
            </p>
            <div class="flex flex-wrap gap-1">
              <span class="text-xs px-2 py-1 bg-gray-100 rounded">#Labor</span>
              <span class="text-xs px-2 py-1 bg-gray-100 rounded">#Socialism</span>
              <span class="text-xs px-2 py-1 bg-gray-100 rounded">#Workers</span>
              <span class="text-xs px-2 py-1 bg-gray-100 rounded">#More...</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Email Instructions -->
    <section class="mb-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-serif font-bold mb-6">How to Submit</h2>
        
        <div class="bg-gray-50 p-8 rounded-lg">
          <ol class="space-y-4 text-gray-700">
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold">1</span>
              <div>
                <strong>Clear Subject Line:</strong> Use "Article Submission: [Your Title]"
              </div>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold">2</span>
              <div>
                <strong>File Format:</strong> PDF or shareable Google Doc link
              </div>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold">3</span>
              <div>
                <strong>Include:</strong> Your name, brief bio (50-100 words), contact info
              </div>
            </li>
            <li class="flex gap-3">
              <span class="flex-shrink-0 w-6 h-6 bg-primary text-white rounded-full flex items-center justify-center text-sm font-bold">4</span>
              <div>
                <strong>Wait:</strong> We'll respond within 1-2 weeks
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <!-- Email Template -->
    <section class="mb-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-serif font-bold mb-6">Email Template</h2>
        
        <div class="bg-gray-100 p-6 rounded-lg">
          <p class="text-gray-700 mb-4">Copy and paste this template:</p>
          
          <div class="bg-white p-6 rounded border border-gray-200 text-sm">
            <p class="mb-2"><strong>To:</strong> nilecomun@gmail.com</p>
            <p class="mb-2"><strong>Subject:</strong> Article Submission: [Your Article Title]</p>
            <p class="mb-4">Dear Editorial Team,</p>
            <p class="mb-4">I would like to submit the following article:</p>
            <p class="mb-2"><strong>Title:</strong> [Your Article Title]</p>
            <p class="mb-2"><strong>Section:</strong> [Section Name]</p>
            <p class="mb-2"><strong>Word Count:</strong> [Number]</p>
            <p class="mb-2"><strong>Tags:</strong> [Tag 1], [Tag 2], [Tag 3]</p>
            <p class="mb-4"><strong>Attachment:</strong> [PDF or Google Doc link]</p>
            <p class="mb-4"><strong>Bio:</strong> [Your 50-100 word bio]</p>
            <p class="mb-4">Thank you for your consideration.</p>
            <p>Sincerely,<br>[Your Name]<br>[Your Email]</p>
          </div>
        </div>
      </div>
    </section>

    <!-- What We're Looking For -->
    <section class="mb-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-serif font-bold mb-6">What We're Looking For</h2>
        
        <div class="grid md:grid-cols-2 gap-6">
          <div class="space-y-3">
            <div class="flex items-start gap-2">
              <CheckCircle className="w-4 h-4 text-green-600 flex-shrink-0 mt-1" />
              <span class="text-gray-700">Current events analysis</span>
            </div>
            <div class="flex items-start gap-2">
              <CheckCircle className="w-4 h-4 text-green-600 flex-shrink-0 mt-1" />
              <span class="text-gray-700">Workers' struggles reports</span>
            </div>
            <div class="flex items-start gap-2">
              <CheckCircle className="w-4 h-4 text-green-600 flex-shrink-0 mt-1" />
              <span class="text-gray-700">Anti-imperialist analysis</span>
            </div>
            <div class="flex items-start gap-2">
              <CheckCircle className="w-4 h-4 text-green-600 flex-shrink-0 mt-1" />
              <span class="text-gray-700">Historical analysis</span>
            </div>
          </div>
          
          <div class="space-y-3">
            <div class="flex items-start gap-2">
              <CheckCircle className="w-4 h-4 text-green-600 flex-shrink-0 mt-1" />
              <span class="text-gray-700">Theory & practice articles</span>
            </div>
            <div class="flex items-start gap-2">
              <CheckCircle className="w-4 h-4 text-green-600 flex-shrink-0 mt-1" />
              <span class="text-gray-700">Culture reviews</span>
            </div>
            <div class="flex items-start gap-2">
              <CheckCircle className="w-4 h-4 text-green-600 flex-shrink-0 mt-1" />
              <span class="text-gray-700">Organizing reports</span>
            </div>
            <div class="flex items-start gap-2">
              <CheckCircle className="w-4 h-4 text-green-600 flex-shrink-0 mt-1" />
              <span class="text-gray-700">Movement building</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Important Notes -->
    <section class="mb-16">
      <div class="max-w-4xl mx-auto">
        <div class="bg-blue-50 border-l-4 border-blue-400 p-6 rounded-lg">
          <div class="flex items-start gap-3">
            <AlertCircle className="w-6 h-6 text-blue-600 flex-shrink-0 mt-1" />
            <div>
              <h3 class="font-bold text-blue-900 mb-2">Important Notes</h3>
              <ul class="space-y-1 text-blue-800">
                <li>• Read our <a href="/editorial-policy" class="underline font-medium">Editorial Policy</a> first</li>
                <li>• Original, unpublished content only</li>
                <li>• Subject to editorial review and revision</li>
                <li>• Contributors retain rights to their work</li>
                <li>• Response time: 1-2 weeks</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final Call to Action -->
    <section class="text-center">
      <h2 class="text-2xl font-serif font-bold mb-4">Ready to Submit?</h2>
      <p class="text-gray-700 mb-6">
        We look forward to reading your contribution to the revolutionary press.
      </p>
      <a 
        href="mailto:nilecomun@gmail.com" 
        class="inline-flex items-center gap-2 bg-primary text-white px-8 py-3 rounded-md font-bold hover:bg-primary-dark transition-colors text-lg"
      >
        <Send className="w-5 h-5" />
        Submit Your Article
      </a>
    </section>
  </div>
</BaseLayout>