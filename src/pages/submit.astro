---
// src/pages/submit.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaTags from '../components/seo/MetaTags.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { FileText, Mail, AlertCircle, CheckCircle, Send, BookOpen, Shield } from 'lucide-react';
---

<BaseLayout 
  title="Submit a Dispatch | The People's Tribune"
  description="Submit your analysis to The People's Tribune. We seek working-class journalism and anti-imperialist theory."
>
  <Fragment slot="head">
    <MetaTags 
      title="Submit a Dispatch | The People's Tribune"
      description="Submit your analysis to The People's Tribune. We seek working-class journalism and anti-imperialist theory."
      type="website"
      url="/submit"
    />
    <StructuredData type="section" />
  </Fragment>

  <div class="bg-black text-white py-20 border-b-8 border-primary overflow-hidden relative">
    <div class="absolute -right-10 -bottom-10 opacity-20 transform rotate-12">
        <Send className="w-64 h-64" />
    </div>
    <div class="container-custom relative z-10">
      <h1 class="text-6xl md:text-9xl font-black uppercase tracking-tighter leading-none mb-6 italic">
        Submit a <span class="text-primary">Dispatch</span>
      </h1>
      <p class="text-2xl font-bold uppercase tracking-widest border-l-8 border-primary pl-6 max-w-2xl">
        Every worker is a witness. Every witness is a reporter. Contribute to the collective press.
      </p>
    </div>
  </div>

  <div class="container-custom py-16">
    <div class="grid lg:grid-cols-12 gap-12">
      
      <div class="lg:col-span-4 space-y-8">
        <div class="bg-primary text-white p-8 border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]">
          <h2 class="text-3xl font-black uppercase mb-4 flex items-center gap-2">
            <Shield className="w-8 h-8" /> Required
          </h2>
          <p class="font-bold mb-4 uppercase text-sm tracking-tight">Before you send your work, you must ensure it aligns with our mission:</p>
          <ul class="space-y-3 font-bold">
            <li class="flex items-start gap-2 border-b border-white/30 pb-2">
              <CheckCircle className="w-5 h-5 flex-shrink-0" /> Marxist-Leninist Analysis
            </li>
            <li class="flex items-start gap-2 border-b border-white/30 pb-2">
              <CheckCircle className="w-5 h-5 flex-shrink-0" /> Original & Unpublished
            </li>
            <li class="flex items-start gap-2 border-b border-white/30 pb-2">
              <CheckCircle className="w-5 h-5 flex-shrink-0" /> Anti-Imperialist Focus
            </li>
          </ul>
          <a href="/editorial-policy" class="mt-6 inline-flex items-center gap-2 bg-black text-white px-4 py-2 text-sm uppercase font-black hover:bg-white hover:text-black transition-all">
            Read Policy <BookOpen className="w-4 h-4" />
          </a>
        </div>

        <div class="border-4 border-dashed border-black p-8">
          <h3 class="text-2xl font-black uppercase mb-4 italic">Submission Specs</h3>
          <div class="space-y-4 text-gray-700">
            <div>
              <p class="font-black uppercase text-xs">Analysis Pieces</p>
              <p class="font-bold">1,000 – 2,500 words</p>
            </div>
            <div>
              <p class="font-black uppercase text-xs">Field Reports</p>
              <p class="font-bold">500 – 800 words</p>
            </div>
            <div>
              <p class="font-black uppercase text-xs">Response Time</p>
              <p class="font-bold">7 - 14 Days</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-8">
        <h2 class="text-5xl font-black uppercase mb-8 tracking-tighter decoration-primary decoration-8 underline underline-offset-8">How to File</h2>
        
        <div class="prose prose-xl max-w-none mb-12">
          <p class="font-bold">We do not use standard corporate submission forms. To maintain security and editorial integrity, please follow the dispatch protocol:</p>
        </div>

        <div class="space-y-6">
          <div class="bg-gray-100 p-8 border-l-8 border-black flex flex-col md:flex-row gap-6 items-center">
            <div class="bg-black text-white p-6 rounded-full">
              <Mail className="w-10 h-10" />
            </div>
            <div class="flex-1 text-center md:text-left">
              <h3 class="text-2xl font-black uppercase mb-1">Electronic Dispatch</h3>
              <p class="text-xl font-bold text-primary mb-2">nilecomun@gmail.com</p>
              <p class="text-sm text-gray-600 uppercase font-bold tracking-widest">Subject: DISPATCH - [Proposed Title]</p>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <div class="border-4 border-black p-6 hover:bg-black hover:text-white transition-all group">
              <h4 class="font-black uppercase text-xl mb-2 group-hover:text-primary">01. Format</h4>
              <p class="font-medium">Attach your text as a .docx, .odt, or link to a secure encrypted document.</p>
            </div>
            <div class="border-4 border-black p-6 hover:bg-black hover:text-white transition-all group">
              <h4 class="font-black uppercase text-xl mb-2 group-hover:text-primary">02. Credentials</h4>
              <p class="font-medium">Include a short bio (2-3 sentences) or specify if you wish to remain anonymous for security.</p>
            </div>
          </div>
        </div>

        <div class="mt-16 bg-black text-white p-12 transform rotate-1 border-t-8 border-primary">
          <h2 class="text-4xl font-black uppercase mb-4 italic">Write for the Masses.</h2>
          <p class="text-xl font-bold mb-8">
            The Tribune is not a place for academic abstraction. We write for the people, 
            about the people, to move the people toward liberation.
          </p>
          <div class="h-2 w-24 bg-primary"></div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>